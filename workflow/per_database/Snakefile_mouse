# -*- coding: utf-8 -*-
# ============================================================================
# Snakefile_mouse: annotation comparison for the MOUSE anchor study
# ----------------------------------------------------------------------------
# Study : Efcab4b knockout mouse liver (Cheng et al. 2025, Biochem Biophys Rep)
# Data  : ArrayExpress E-MTAB-13110 / ENA ERP148613 (3x WT vs 3x KO, PE 150 bp)
# Genome: Ensembl GRCm39. Annotations compared: Ensembl 110, RefSeq, GENCODE vM33
#         (= Ensembl 110 gene models), UCSC, as in the calibration
#         (run_mouse_final.sh: Ensembl 110 anchor, featureCounts defaults, no -O/-M).
#         Every annotation is mapped to ITS OWN database's genome, with its native
#         coordinates and chromosome names (no renaming): Ensembl 110 primary
#         assembly, RefSeq GCF_000001635.27, GENCODE M33 primary assembly, UCSC mm39.
#         Requires star_index_mode: per_annotation.
# Run   :  snakemake -s Snakefile_mouse --profile profiles/slurm
#          (STAR index mode + data paths: config/pipeline.yaml)
# ============================================================================

configfile: "config/pipeline.yaml"

ORGANISM = "mouse"
COUNTS_ONLY = True

