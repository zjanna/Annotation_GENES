GENOME_URL = "https://ftp.ensembl.org/pub/release-110/fasta/mus_musculus/dna/Mus_musculus.GRCm39.dna.primary_assembly.fa.gz"
REF = f"reference/{ORGANISM}/Mus_musculus.GRCm39.110.dna.primary_assembly.fa"

# --- one genome per annotation (native chromosome names) ---
GENOMES = {
    "ensembl": {"path": REF, "url": GENOME_URL},
    "refseq":  {"path": f"reference/{ORGANISM}/genome/GCF_000001635.27_GRCm39_genomic.fa",
                "url":  "https://ftp.ncbi.nlm.nih.gov/genomes/all/annotation_releases/10090/GCF_000001635.27-RS_2024_02/GCF_000001635.27_GRCm39_genomic.fna.gz"},
