def get_reads(sample):
    d = "data/dog/reads"
    if os.path.isfile(f"{d}/{sample}.1.fastq.gz") and os.path.isfile(f"{d}/{sample}.2.fastq.gz"):
        return {"r1": f"{d}/{sample}.1.fastq.gz", "r2": f"{d}/{sample}.2.fastq.gz"}
    return {"r1": f"data/{ORGANISM}/reads/{sample}.1.fastq.gz",
            "r2": f"data/{ORGANISM}/reads/{sample}.2.fastq.gz"}

